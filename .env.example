# QuantPulse AI v5.1 — Stage 1 Free Indian Broker API Configuration (.env)
# Copy this file to .env and fill in EITHER Angel One SmartAPI OR Upstox API v2 OR Fyers API v3
STAGE1_PAPER_ONLY=true
ACTIVE_BROKER=ANGEL_ONE_SMARTAPI

# Option 1: Angel One SmartAPI (100% Free: Order API + WebSocket 2.0 + getCandleData History)
# Create free app at: https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_angel_smartapi_key_here
ANGEL_CLIENT_CODE=your_angel_client_id_here
ANGEL_MPIN=your_4_digit_mpin
ANGEL_TOTP_SECRET=your_totp_secret_string_for_pyotp

# Option 2: Upstox Developer API v2/v3 (100% Free: Order API + WebSocket V3 + Historical Candles)
# Create free app at: https://upstox.com/trading-api/
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_ACCESS_TOKEN=your_daily_oauth_access_token

# Option 3: Fyers API v3 (100% Free: Order API + TBT DataSocket + History API)
# Create free app at: https://myapi.fyers.in/
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_ID=your_fyers_secret_id
FYERS_ACCESS_TOKEN=your_fyers_access_token
